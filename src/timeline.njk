---
layout: base.njk
section: timeline
permalink: /timeline/
extraStyles:
  - timeline.css
eleventyComputed:
  title: "Timeline"
  description: "Turn through {{ missions | length }} space missions like pages of a book — search, jump, and land on any mission."
---

<section class="container page-head">
  <p class="hero-kicker">The flip-book</p>
  <h1>Turn the pages of space history</h1>
  <p class="hook">
    Every mission holds one page, in chronological order. Search for a
    mission — or a near-misspelling — and watch the book riffle there.
    Arrow keys turn pages; <kbd>/</kbd> focuses search.
  </p>
</section>

<div class="flip-layout">
  <!-- sidebar: search + era jumps -->
  <aside class="flip-side">
    <div class="flip-search">
      <label class="mono-tag" for="flip-search-input" style="display:block;margin-bottom:.4rem">
        Search the record
      </label>
      <input
        id="flip-search-input"
        type="search"
        placeholder='try "vikram" or "voyagr"'
        autocomplete="off"
        aria-describedby="search-help"
      />
      <p id="search-help" class="mono-tag" hidden>↑↓ navigate · Enter jumps · Esc closes</p>
      <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
    </div>

    <nav class="flip-index" aria-label="Jump to era">
      <h2>Jump to an era</h2>
      <div class="era-jump-list">
        {% set sortedMissions = missions | sortByYear %}
        {% set eras = [] %}
        {% for m in sortedMissions %}
          {% if m.era not in eras %}{% set eras = (eras | push(m.era)) %}{% endif %}
          {% if loop.last %}{% endif %}
        {% endfor %}
        {% for era in eras %}
          {% set firstOfEra = none %}
          {% for m in sortedMissions %}
            {% if m.era == era and firstOfEra == none %}{% set firstOfEra = loop.index0 %}{% endif %}
          {% endfor %}
          <button type="button" class="chip-btn" data-era-index="{{ firstOfEra }}"
                  style="--era-accent: {{ era | eraAccent }}">
            {{ era.split(':')[0] }}
          </button>
        {% endfor %}
      </div>
    </nav>

    <p class="mono-tag flip-legend">
      ← → turn · Home/End ends · M mute · S skip animation
    </p>
  </aside>

  <!-- stage -->
  <div class="flip-main">
    <div class="flip-progress" aria-hidden="true"><i id="flip-progress-bar"></i></div>

    <div class="book-stage">
      <div class="book" id="book">
        <!-- left context page (desktop only) -->
        <div class="book-half book-left">
          <div class="context-sheet">
            <span class="context-era" id="ctx-era"></span>
            <span class="context-count" id="ctx-count"></span>
            <span class="context-label">of {{ missions | length }} missions</span>
            <span class="context-name"><a id="ctx-link" href="#"></a></span>
          </div>
        </div>

        <!-- right page: static current view + flipping sheet -->
        <div class="book-half book-right">
          <div class="mission-sheet" id="current-sheet"><!-- JS renders --></div>
          <div class="page-flipper" id="page-flipper" aria-hidden="true">
            <div class="page-face front" id="flip-front"><div class="mission-sheet"></div></div>
            <div class="page-face back" id="flip-back"><div class="mission-sheet"></div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="flip-controls">
      <button type="button" class="ctrl-btn" id="btn-first" aria-label="First mission">⏮</button>
      <button type="button" class="ctrl-btn" id="btn-prev" aria-label="Previous mission">←</button>
      <span class="flip-counter" id="flip-counter" aria-live="polite">1 / {{ missions | length }}</span>
      <button type="button" class="ctrl-btn" id="btn-next" aria-label="Next mission">→</button>
      <button type="button" class="ctrl-btn" id="btn-last" aria-label="Last mission">⏭</button>
    </div>

    <div class="toggle-row">
      <a class="toggle-btn" id="open-mission-link" href="#">Open full page ↗</a>
      <button type="button" class="toggle-btn" id="mute-toggle" aria-pressed="false">Sound on</button>
      <button type="button" class="toggle-btn skip-anim-btn" id="skip-anim">Skip animation</button>
    </div>
  </div>
</div>

<!-- dataset snapshot for the client-side controller -->
<script type="application/json" id="missions-data">{{ sortedMissions | dump | safe }}</script>
<script src="/scripts/timeline-flip.js" defer></script>
