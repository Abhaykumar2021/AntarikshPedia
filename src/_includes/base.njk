<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if title %}<title>{{ title }} — AntarikshPedia</title>{% else %}<title>AntarikshPedia — A Connected History of Space Exploration</title>{% endif %}
  <meta name="description" content="{{ description or 'A connected encyclopedia of humanity’s journey into space — 209 missions from Sputnik to today, explored as one story.' }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or 'AntarikshPedia' }}">
  <meta property="og:description" content="{{ description or 'A connected encyclopedia of humanity’s journey into space.' }}">
  <meta property="og:type" content="website">

  <!-- Fonts: Space Grotesk (display) / Inter (body) / JetBrains Mono (telemetry) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

  {#- theme: resolve before first paint to avoid a flash -#}
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('ap-theme');
        var theme = stored ||
          (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      } catch (e) { /* storage blocked: dark default stands */ }
    })();
  </script>

  <link rel="stylesheet" href="/styles/tokens.css">
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/components.css">
  {% for sheet in extraStyles %}<link rel="stylesheet" href="/styles/{{ sheet }}">{% endfor %}

  {#- schema.org structured data per mission page -#}
  {% if schema %}
  <script type="application/ld+json">{{ schema | dump(2) | safe }}</script>
  {% endif %}

  {#- cross-document view transitions -#}
  <style>@view-transition { navigation: auto; }</style>

  <script src="/scripts/main.js" defer></script>
  {#- global mission search: dataset snapshot + fuzzy index on every page -#}
  <script type="application/json" id="all-missions">{{ missions | sortByYear | dump | safe }}</script>
  <script type="module" src="/scripts/global-search.js"></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/">Antariksh<b>Pedia</b></a>
      <form class="header-search" role="search" id="global-search-form">
        <input
          type="search"
          id="global-search-input"
          placeholder="Search {{ missions | length }} missions…"
          aria-label="Search missions"
          autocomplete="off"
        />
        <ul class="search-results" id="global-results" role="listbox" aria-label="Search results"></ul>
      </form>
      <nav class="site-nav" aria-label="Primary">
        <a href="/" {% if section == 'home' %}aria-current="page"{% endif %}>Home</a>
        <a href="/timeline/" {% if section == 'timeline' %}aria-current="page"{% endif %}>Timeline</a>
        <a href="/catalog/" {% if section == 'catalog' %}aria-current="page"{% endif %}>Catalog</a>
        <a href="/agencies/" {% if section == 'agencies' %}aria-current="page"{% endif %}>Agencies</a>
        <a href="/countries/" {% if section == 'countries' %}aria-current="page"{% endif %}>Countries</a>
        <a href="/vision/" {% if section == 'vision' %}aria-current="page"{% endif %}>Vision</a>
      </nav>
      <button id="theme-toggle" class="theme-toggle" type="button"
              aria-label="Switch color theme" title="Switch color theme">
        <span aria-hidden="true" class="theme-icon">☾</span>
      </button>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p class="footer-note">
      AntarikshPedia is a connected encyclopedia of humanity's journey into
      space — agencies, programs, missions, spacecraft, people, discoveries,
      and the history that shaped them.
    </p>
    <nav class="footer-links" aria-label="Footer">
      <a href="/timeline/">Timeline</a>
      <a href="/catalog/">Mission catalog</a>
      <a href="/agencies/">Agencies</a>
      <a href="/countries/">Countries</a>
      <a href="/admin/">Contributions</a>
    </nav>
    <p class="footer-copy">
      Built and maintained by Abhay Kumar · Imagery courtesy of NASA / ISRO / ESA where credited · Educational and non-commercial
    </p>
  </footer>
</body>
</html>
