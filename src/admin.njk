{#- ============================================================
   Contribution staging area (Phase 3 groundwork).
   CRUD operations run client-side against a localStorage overlay
   of missions.json — nothing touches the canonical dataset until
   an export is reviewed and committed by a maintainer.
   ============================================================ -#}

<section class="container page-head">
  <p class="hero-kicker">Phase 3 groundwork</p>
  <h1>Contribution staging</h1>
  <p class="hook">
    Create, edit, or retire mission records here. Changes are staged in your
    browser only; <strong>export the JSON</strong> and send it to a maintainer,
    who reviews it against cited sources before it reaches
    <code>missions_timeline.md</code>. Nothing is published automatically.
  </p>
</section>

<section class="container">
  <div class="section-head">
    <h2>Staged changes</h2>
    <span class="mono-tag" id="staged-count">0 staged</span>
    <div style="margin-left:auto; display:flex; gap:.5rem; flex-wrap:wrap">
      <button type="button" class="btn btn-ghost" id="btn-import">Import JSON</button>
      <button type="button" class="btn" id="btn-export">Export for review</button>
      <button type="button" class="btn-ghost toggle-btn" id="btn-discard">Discard all</button>
    </div>
  </div>

  <form id="mission-form" class="crud-form" autocomplete="off">
    <input type="hidden" name="_mode" value="create">
    <fieldset>
      <legend><span id="form-title">New mission record</span></legend>

      <label>Name<input name="name" required maxlength="80"></label>
      <label>Year<input name="year" type="number" min="1957" max="2030" required></label>

      <label>Lead / partner
        <input name="lead_partner" list="lead-options" required>
        <datalist id="lead-options">
          {% for agency in agencies %}<option value="{{ agency.name }}"></option>{% endfor %}
        </datalist>
      </label>

      <label>Target<input name="target" required maxlength="60"></label>
      <label>Category<input name="category" required maxlength="60"></label>

      <label>Status
        <select name="status" required>
          {% for s in ['Success', 'Partial success', 'Failure', 'In transit', 'Operational'] %}
          <option>{{ s }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="wide">Outcome (one line)<input name="outcome" required maxlength="140"></label>
      <label>Era
        <select name="era" required>
          {% set eras = [] %}
          {% for m in missions %}{% if m.era not in eras %}{% set eras = (eras | push(m.era)) %}{% endif %}{% endfor %}
          {% for era in eras %}<option>{{ era }}</option>{% endfor %}
        </select>
      </label>

      <label class="wide">Intro write-up (optional)
        <textarea name="intro" rows="3" maxlength="1200"></textarea>
      </label>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-solid" id="btn-save">Stage change</button>
      <button type="button" class="toggle-btn" id="btn-cancel-edit" hidden>Cancel edit</button>
      <output class="mono-tag" id="form-status" aria-live="polite"></output>
    </div>
  </form>

  <table class="crud-table" aria-describedby="staged-note">
    <caption id="staged-note" class="mono-tag">
      Base dataset shown greyed; staged rows highlighted.
    </caption>
    <thead>
      <tr><th>ID</th><th>Name</th><th>Year</th><th>Status</th><th>Change</th><th>Ops</th></tr>
    </thead>
    <tbody id="crud-tbody"></tbody>
  </table>
</section>

<!-- base dataset snapshot for the staging table -->
<script type="application/json" id="base-missions">{{ missions | dump | safe }}</script>
<script>
  window.__AP_MISSIONS__ = JSON.parse(
    document.getElementById('base-missions').textContent
  );
</script>
<script src="/admin/admin.js" defer></script>
